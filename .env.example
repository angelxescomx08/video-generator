# ---- Postgres ----
POSTGRES_USER=videogen
POSTGRES_PASSWORD=changeme
POSTGRES_DB=videogen
DATABASE_URL=postgresql://videogen:changeme@localhost:5432/videogen

# ---- pg-boss ----
PGBOSS_SCHEMA=pgboss

# ---- App ----
# El puerto 3001 esta fijado a proposito en apps/web/package.json (`next dev -p 3001`), no es el
# default de Next. Si se deja que Next elija, toma 3000 cuando esta libre y salta a 3001 cuando no —
# y un puerto que cambia rompe el OAuth en silencio, porque el URI de redireccion registrado en
# Google Cloud deja de coincidir. Este valor, el de los *_REDIRECT_URI de abajo y el URI registrado
# en Google Cloud / Meta tienen que apuntar todos al mismo puerto.
NEXT_PUBLIC_APP_URL=http://localhost:3001
NODE_ENV=development

# ---- AI provider selection (fallback if no provider_configs DB row) ----
AI_PROVIDER=ollama                # ollama | openai | gemini | anthropic
EMBEDDING_PROVIDER=ollama         # independent from AI_PROVIDER (anthropic has no embeddings API)

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

GOOGLE_GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
GEMINI_EMBEDDING_MODEL=gemini-embedding-2   # text-embedding-004 fue retirado (404)

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# ---- TTS provider selection ----
TTS_PROVIDER=piper                # piper | coqui | elevenlabs | azure | google
TTS_BASE_URL=http://localhost:5002

ELEVENLABS_API_KEY=
ELEVENLABS_DEFAULT_VOICE_ID=

AZURE_TTS_KEY=
AZURE_TTS_REGION=

# Google Cloud Text-to-Speech: habilita la API "Cloud Text-to-Speech" en tu proyecto de GCP y
# crea una API key (no requiere cuenta de servicio). Precios ago 2026: WaveNet $4/1M caracteres,
# Neural2 $16/1M, Chirp3 HD $30/1M (el nombre de la voz determina el precio, ver pricing.ts).
GOOGLE_TTS_API_KEY=
GOOGLE_TTS_VOICE_NAME=es-US-Neural2-A
GOOGLE_TTS_LANGUAGE_CODE=es-US

# ---- Stock footage providers (free ones can be enabled together) ----
PIXABAY_API_KEY=
PEXELS_API_KEY=
SHUTTERSTOCK_API_KEY=
SHUTTERSTOCK_API_SECRET=
STORYBLOCKS_API_KEY=
STORYBLOCKS_PRIVATE_KEY=
STORYBLOCKS_PROJECT_ID=

# ---- Royalty-free background music ----
JAMENDO_CLIENT_ID=

# ---- Busqueda web (propuestas de tema, pantalla /topics) ----
# Sin nada configurado cae a Wikipedia, que funciona pero busca en UN solo sitio.
# Para busqueda web de verdad, Tavily es la opcion recomendada: 1.000 busquedas/mes
# gratis, sin tarjeta (alta en tavily.com).
SEARCH_PROVIDER=
TAVILY_API_KEY=
# Brave cobra desde la primera consulta desde febrero de 2026.
BRAVE_API_KEY=
# SearXNG autohospedado ("pnpm docker:up:search"). Solo se usa si SEARCH_PROVIDER=searxng.
# AVISO: desde una IP domestica los motores upstream le devuelven resultados senuelo
# (incluido contenido no deseado). Sirve en un servidor con IP limpia, no en un portatil.
SEARXNG_URL=http://localhost:8888

# ---- Social platforms (OAuth) ----
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REDIRECT_URI=http://localhost:3001/api/oauth/youtube/callback

FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_REDIRECT_URI=http://localhost:3001/api/oauth/facebook/callback

# ---- Secrets ----
TOKEN_ENCRYPTION_KEY=changeme-32-byte-minimum-secret-key

# ---- Worker/render ----
# IMPORTANT: use an ABSOLUTE path here, not a relative one. In native dev (non-Docker), apps/web
# and apps/worker run from different working directories — a relative path like "./data/renders"
# resolves to a different real folder for each process, so web can't find files the worker wrote.
# Example (adjust to your machine): C:/Users/you/projects/video-generator/data/renders
RENDER_OUTPUT_DIR=/absolute/path/to/video-generator/data/renders
WORKER_TMP_DIR=/absolute/path/to/video-generator/data/tmp
MUSIC_LIBRARY_DIR=/absolute/path/to/video-generator/data/music
FFMPEG_PATH=
# Solo si ffprobe no esta en el PATH ni junto a FFMPEG_PATH. Se usa para medir la duracion real
# del audio TTS de proveedores que no la reportan (Google/ElevenLabs/Azure) — sin esa medicion los
# subtitulos y los cortes de escena quedan en 0s.
FFPROBE_PATH=


JAMENDO_CLIENT_ID=tu_client_id
